+/* Publish the Thumb hook boundary and check exits in one helper, avoiding
+ * separate interpreter calls and state stores for every instruction. */
+void HELPER(uc_thumb_hook)(CPUARMState *env, uint32_t pc,
+                           uint32_t itstate, uint32_t size)
+{
+    uc_engine *uc = env_cpu(env)->uc;
+    env->regs[15] = pc;
+    env->condexec_bits = itstate;
+    HELPER(uc_tracecode)(size, UC_HOOK_CODE_IDX, uc, pc);
+    if (cpu_loop_exit_requested(uc->cpu)) uc->skip_sync_pc_on_exit = true;
+    HELPER(check_exit_request)(uc, 0);
+    env->condexec_bits = 0;
+}
