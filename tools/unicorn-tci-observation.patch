+uc_err uc_hook_set_mem_filter(uc_engine *uc, uc_hook hh, uc_cb_mem_filter_t filter)
+{
+    for (int index = UC_HOOK_MEM_READ_IDX; index <= UC_HOOK_MEM_WRITE_IDX; index++) {
+        for (struct list_item *cur = uc->hook[index].head; cur; cur = cur->next) {
+            struct hook *hook = cur->data;
+            if ((uc_hook)hook == hh && !hook->to_delete) {
+                hook->mem_filter = filter;
+                return UC_ERR_OK;
+            }
+        }
+    }
+    return UC_ERR_ARG;
+}
