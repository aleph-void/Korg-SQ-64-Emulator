{
  "format": "sq64-critical-checks",
  "version": 1,
  "specVersion": "0.3.0",
  "terminateOnCritical": true,
  "warning": "Your custom firmware probably will brick your device. Do not flash it.",
  "claim": "A hazard detection pass is unsafe. No detected hazard is not proof that firmware is safe to flash.",
  "checks": [
    {
      "id": "CRITICAL-001",
      "title": "Internal recovery flash mutation attempted",
      "severity": "critical",
      "unsafeWhen": "pass",
      "requirements": [
        "RECOVERY-001",
        "RECOVERY-002"
      ]
    },
    {
      "id": "CRITICAL-002",
      "title": "Persistent system configuration write attempted",
      "severity": "critical",
      "unsafeWhen": "pass",
      "requirements": [
        "RECOVERY-003"
      ]
    },
    {
      "id": "CRITICAL-003",
      "title": "Forbidden or unmodeled SPI flash command attempted",
      "severity": "critical",
      "unsafeWhen": "pass",
      "requirements": [
        "RECOVERY-003"
      ]
    },
    {
      "id": "CRITICAL-004",
      "title": "Installed SPI firmware mutation attempted",
      "severity": "critical",
      "unsafeWhen": "pass",
      "requirements": [
        "RECOVERY-002",
        "RECOVERY-004"
      ]
    },
    {
      "id": "CRITICAL-005",
      "title": "Unsafe DMA destination attempted",
      "severity": "critical",
      "unsafeWhen": "pass",
      "requirements": [
        "RECOVERY-002",
        "RECOVERY-003"
      ]
    }
  ]
}
